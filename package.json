{
  "name": "ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run generate:icons && vite",
    "build": "bun run generate:icons && tsc -b tsconfig.build.json && vite build && bun run compress:static",
    "lint": "eslint . && biome check .",
    "format": "biome check --write --unsafe .",
    "preview": "vite preview",
    "generate:icons": "bun ./scripts/generate-icon-theme.mts",
    "compress:static": "bun ./scripts/compress-static.mts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@monaco-editor/loader": "1.7.0",
    "@monaco-editor/react": "4.7.0",
    "@shikijs/monaco": "4.4.3",
    "@tanstack/react-hotkeys": "0.10.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "client-zip": "2.5.0",
    "cmdk": "1.1.1",
    "dockview-core": "8.2.0",
    "dockview-react": "8.2.0",
    "jotai": "2.20.3",
    "lucide-react": "1.40.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.3",
    "shiki": "4.4.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "bun": "1.4.0",
    "eslint": "10.9.1",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "material-icon-theme": "5.38.1",
    "tailwindcss": "4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2"
  }
}
