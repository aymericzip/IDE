{
  "name": "ide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run generate:icons && bun run generate:sitemap && vite",
    "build": "bun run generate:icons && bun run generate:sitemap && tsc -b tsconfig.build.json && vite build && bun run compress:static",
    "lint": "eslint . && biome check .",
    "format": "biome check --write --unsafe .",
    "preview": "vite preview",
    "generate:icons": "bun ./scripts/generate-icon-theme.mts",
    "generate:og": "bun ./scripts/generate-og-image.mts",
    "generate:sitemap": "bun ./scripts/generate-sitemap.mts",
    "compress:static": "bun ./scripts/compress-static.mts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@monaco-editor/loader": "1.7.0",
    "@monaco-editor/react": "4.7.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@shikijs/monaco": "4.6.0",
    "@tanstack/react-hotkeys": "0.10.0",
    "class-variance-authority": "0.7.1",
    "client-zip": "2.5.1",
    "cmdk": "1.1.1",
    "cnfast": "0.1.0",
    "dockview-core": "8.9.0",
    "dockview-react": "8.9.0",
    "jotai": "2.20.3",
    "lucide-react": "1.71.0",
    "monaco-editor": "0.52.2",
    "preact": "10.29.8",
    "react-resizable-panels": "4.21.0",
    "satori": "0.33.5",
    "shiki": "4.6.0",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@eslint/js": "10.0.1",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "bun": "1.4.4",
    "eslint": "10.14.0",
    "eslint-config-biome": "^2.1.3",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "material-icon-theme": "5.40.0",
    "tailwindcss": "4.3.5",
    "typescript": "~7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
